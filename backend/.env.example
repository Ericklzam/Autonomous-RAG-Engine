# Copy this file to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored; this template is safe to commit.

# --- PostgreSQL / pgvector credentials ---
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=rag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- SQLAlchemy connection string ---
# Must match the credentials above. Use host "db" instead of "localhost"
# if you run the app inside the same docker-compose network.
DATABASE_URL=postgresql+psycopg2://rag_user:replace_with_a_strong_password@localhost:5432/rag_db
